# API URL for the frontend
#
# Configuration options:
# - Leave empty (VITE_API_URL=) to use Nginx proxy
#   This is recommended for production and when running via `make all-full`
#   All API requests will be proxied through Nginx on the same origin
#
# - Set to http://localhost:8000 (VITE_API_URL=http://localhost:8000) for local development
#   Use this when running `npm run dev` locally without Nginx
#   This bypasses the Docker setup and connects directly to the backend
#
VITE_API_URL=
